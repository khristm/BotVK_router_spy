# Задержка между сканированиями роутера при активном статусе слежения
DELAY_CHECK_ROUTER_SECONDS=600
# Задержка перед оповещением об отключении клиента от роутера
# (для исключения флуда сообщениями об устройствах по wi-fi с энергосбережением)
DELAY_OFFLINE_DEVICE_NOTIF_MINUTES=15
# OID snmp выдающий активных клиентов
OID_ONLINE_DEVICE=.1.3.6.1.4.1.8072.2.255
# token сообщества в вк, (необходимы разрешения писать сообщения, включенный LongPoll)
TOKEN_MESSENGER=vk1.group_token
# ID группы в ВК
GROUP_ID=000000001
# Относительный путь до файла с настройками юзеров
PATH_USER_CONFIG=users.yml
